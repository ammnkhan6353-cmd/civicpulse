# Copy to .env (which is gitignored) and fill in:   cp .env.example .env
# NEVER commit .env. Placeholders only in this file.

POSTGRES_DB=civicpulse
POSTGRES_USER=civicpulse
POSTGRES_PASSWORD=change-me-local-only

# llm | ollama | rules | simulated
TRIAGE_PROVIDER=llm
# Your own key from https://console.groq.com  (without a valid key every complaint
# still works - it is triaged by the rules fallback and marked rules:fallback)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_MODEL=llama3.2:1b
SIMULATED_FAILURE_MODE=none

RATE_LIMIT_PER_MINUTE=10
LOG_LEVEL=INFO
